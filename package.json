{
  "name": "sakinah",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web", "apps/api"],
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "preview": "npm run preview -w apps/web",
    "start": "npm run start -w apps/api",
    "test": "npm run test -w apps/api && npm run test -w apps/web",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:push": "npm run db:push -w apps/api",
    "assets": "node scripts/generate-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "concurrently": "10.0.7",
    "sharp": "0.35.5"
  }
}